+                    return False
+                content = message.get("content")
+                return isinstance(content, str) and len(content) <= 512
+
+            def _get(self):
+                # Queue.get holds the same mutex as the upstream claim bookkeeping.
+                # Retain FIFO within each class. After two overtakes serve the oldest.
+                if self.queue and self.queue[0].type == "new_request" and self.promotions < 2 and not self.brief(self.queue[0]):
+                    for pos, item in enumerate(islice(self.queue, 1, 12), 1):
