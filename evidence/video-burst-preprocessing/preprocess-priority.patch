+
+            @staticmethod
+            def brief(item):
+                if item.type != "new_request":
+                    return False
+                payload = item.data
+                if (payload.request.metadata or {}).get("task") in ("tts", "transcription"):
+                    return False
+                inp = payload.request.inputs
