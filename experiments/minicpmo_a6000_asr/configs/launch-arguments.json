{
  "description": "Historical server arguments with explicit path placeholders; extraction was checked offline. This file is not an executable launcher.",
  "entrypoint": "scripts/runtime/serve_sglang_bench.py",
  "arguments": [
    "--model-path",
    "${MODEL_PATH}",
    "--host",
    "127.0.0.1",
    "--port",
    "18001",
    "--thinker.engine.attention_backend",
    "triton",
    "--thinker.engine.dtype",
    "bfloat16",
    "--thinker.engine.mem_fraction_static",
    "0.60",
    "--thinker.engine.max_running_requests",
    "8",
    "--thinker.engine.cuda_graph_max_bs",
    "8",
    "--no-cache",
    "--talker.engine.attention_backend",
    "triton",
    "--talker.engine.mem_fraction_static",
    "0.15",
    "--talker.engine.max_running_requests",
    "4",
    "--talker.engine.cuda_graph_max_bs",
    "4",
    "--code2wav.factory.dtype",
    "float32",
    "--code2wav.factory.enable_dit_torch_compile",
    "false",
    "--code2wav.factory.enable_hift_torch_compile",
    "false",
    "--code2wav.factory.enable_flow_cuda_graph",
    "false",
    "--config-output",
    "${RUN_OUTPUT}/resolved_config.json",
    "--endpoints.base_path",
    "${IPC_PATH}"
  ],
  "environment": {
    "P3_RUN_ID": "${RUN_ID}",
    "OMP_NUM_THREADS": "8",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "SGLANG_TEST_RETRACT": "0"
  },
  "allocation_inherited": [
    "SLURM_JOB_ID",
    "CUDA_VISIBLE_DEVICES"
  ],
  "cpu_affinity_count": 16,
  "timeouts_s": {
    "startup_timeout_seconds": 1200,
    "request_timeout_seconds": 180,
    "window_timeout_seconds": 900,
    "service_timeout_seconds": 3600
  }
}
